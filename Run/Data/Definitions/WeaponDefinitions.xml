<Definitions>
  <!-- Pistol -->
  <WeaponDefinition name="Pistol" refireTime="0.5" rayCount="1" rayCone="0.0" rayRange="40.0" rayDamage="10.0~15.0" rayImpulse="40.0">
    <HUD shader="Diffuse" baseTexture="Data/Images/Hud_Base.png" reticleTexture="Data/Images/Reticle.png" reticleSize="16,16" 
		 spriteSheet="Data/Images/Weapon_Pistol.png" 
		 spriteSheetNormal="Data/Images/Weapon_Pistol_normal.png" 
		 spriteSheetEmissive="Data/Images/Weapon_Pistol_emissive.png" 
		 cellCount="5,1" spriteSize="256,256" spritePivot="0.5,0.0">
      <Animation name="Idle" shader="Diffuse" secondsPerFrame="0.1" startFrame="0" endFrame="0"/>
      <Animation name="Attack" shader="Diffuse" secondsPerFrame="0.1" startFrame="1" endFrame="4" />
    </HUD>
    <Sounds>
      <Sound sound="Fire" name="Data/Audio/PistolFire.wav"/>
    </Sounds>
  </WeaponDefinition>
  <!-- Plasma Rifle -->
  <WeaponDefinition name="PlasmaRifle" refireTime="0.1" projectileCount="1" projectileActor="PlasmaProjectile" projectileCone="4.0" projectileSpeed="40.0">
    <HUD shader="Diffuse" baseTexture="Data/Images/Hud_Base.png" reticleTexture="Data/Images/Reticle.png" reticleSize="16,16" 
		 spriteSheet="Data/Images/Weapon_Plasma.png" 
		 spriteSheetNormal="Data/Images/Weapon_Plasma_normal.png" 
		 spriteSheetEmissive="Data/Images/Weapon_Plasma_emissive.png" 
		 cellCount="4,1" spriteSize="256,256" spritePivot="0.5,0.0">
      <Animation name="Idle" shader="Diffuse" secondsPerFrame="0.075" startFrame="0" endFrame="0" />
      <Animation name="Attack" shader="Diffuse" secondsPerFrame="0.075" startFrame="1" endFrame="3" />
    </HUD>
    <Sounds>
      <Sound sound="Fire" name="Data/Audio/PlasmaFire.wav"/>
    </Sounds>
  </WeaponDefinition>
  <!-- Fishrod -->
  <WeaponDefinition name="Fishrod" refireTime="1." projectileCount="1" projectileActor="FishingFloat" projectileCone="0.0" projectileSpeed="50.0" isReuseableProjectile="true">
  	<HUD shader="Diffuse" baseTexture="Data/Images/Hud_Base.png" reticleTexture="Data/Images/Reticle.png" reticleSize="16,16"
  			spriteSheet="Data/Images/Weapon_Fishrod.png"
		    spriteSheetNormal="Data/Images/Weapon_Fishrod_normal.png"
		    spriteSheetEmissive="Data/Images/Weapon_Fishrod_emissive.png"
  			cellCount="5,1" spriteSize="512,512" spritePivot="0.5,0.0">
  		<Animation name="Idle" shader="Diffuse" secondsPerFrame="0.075" startFrame="0" endFrame="0" />
  		<Animation name="Attack" shader="Diffuse" secondsPerFrame="0.075" startFrame="1" endFrame="3" />
  	</HUD>
  	<Sounds>
  		<Sound sound="Fire" name="Data/Audio/FishrodFire.wav"/>
  	</Sounds>
  </WeaponDefinition>
	<!-- Fish -->
	<WeaponDefinition name="Fish" refireTime="1." meleeCount="1" meleeArc="180.0" meleeRange="3.75" meleeDamage="20.0~30.0" meleeImpulse="30">
		<HUD shader="Diffuse" baseTexture="Data/Images/Hud_Base.png" reticleTexture="Data/Images/Reticle.png" reticleSize="16,16"
				spriteSheet="Data/Images/Weapon_Fish.png"
				spriteSheetNormal="Data/Images/Weapon_Fish_normal.png"
				spriteSheetEmissive="Data/Images/Weapon_Fish_emissive.png"
				cellCount="4,3" spriteSize="256,256" spritePivot="0.5,0.0">
			    <Animation name="0" shader="Diffuse" secondsPerFrame="0." startFrame="0" endFrame="0" />
			    <Animation name="1" shader="Diffuse" secondsPerFrame="0." startFrame="1" endFrame="1" />
			    <Animation name="2" shader="Diffuse" secondsPerFrame="0." startFrame="2" endFrame="2" />
			    <Animation name="3" shader="Diffuse" secondsPerFrame="0." startFrame="3" endFrame="3" />
			    <Animation name="4" shader="Diffuse" secondsPerFrame="0." startFrame="4" endFrame="4" />
			    <Animation name="5" shader="Diffuse" secondsPerFrame="0." startFrame="5" endFrame="5" />
			    <Animation name="6" shader="Diffuse" secondsPerFrame="0." startFrame="6" endFrame="6" />
			    <Animation name="7" shader="Diffuse" secondsPerFrame="0." startFrame="7" endFrame="7" />
			    <Animation name="8" shader="Diffuse" secondsPerFrame="0." startFrame="8" endFrame="8" />
			    <Animation name="9" shader="Diffuse" secondsPerFrame="0." startFrame="9" endFrame="9" />
		</HUD>
		<Sounds>
			<Sound sound="Fire" name="Data/Audio/FishFire.mp3"/>
		</Sounds>
	</WeaponDefinition>
  <!-- Demon Melee -->
  <WeaponDefinition name="DemonMelee" refireTime="2.0" meleeCount="1" meleeArc="180.0" meleeRange="3.75" meleeDamage="20.0~30.0" meleeImpulse="30">
	<HUD shader="Diffuse" baseTexture="Data/Images/Hud_Base.png" reticleTexture="Data/Images/Reticle.png" reticleSize="16,16"
		spriteSheet="Data/Images/Default.png"
		spriteSheetNormal="Data/Images/Default.png"
		spriteSheetEmissive="Data/Images/Default.png"
		cellCount="4,1" spriteSize="256,256" spritePivot="0.5,0.0">
	</HUD>
    <Sounds>
      <Sound sound="Fire" name="Data/Audio/DemonAttack.wav"/>
    </Sounds>
  </WeaponDefinition>
	<!-- Demon Dragon Melee -->
	<WeaponDefinition name="DemonDragonMelee" refireTime="2.0" meleeCount="1" meleeArc="180.0" meleeRange="10.0" meleeDamage="20.0~30.0" meleeImpulse="50">
		<HUD shader="Diffuse" baseTexture="Data/Images/Hud_Base.png" reticleTexture="Data/Images/Reticle.png" reticleSize="16,16"
			spriteSheet="Data/Images/Default.png"
			spriteSheetNormal="Data/Images/Default.png"
			spriteSheetEmissive="Data/Images/Default.png"
			cellCount="4,1" spriteSize="256,256" spritePivot="0.5,0.0">
		</HUD>
		<Sounds>
			<Sound sound="Fire" name="Data/Audio/DemonAttack.wav"/>
		</Sounds>
	</WeaponDefinition>
	<!-- Demon Fireball -->
	<WeaponDefinition name="DemonDragonFireball" refireTime="0.2" projectileCount="1" projectileActor="FireballProjectile" projectileCone="5.0" projectileSpeed="80.0">
		<HUD shader="Diffuse" baseTexture="Data/Images/Hud_Base.png" reticleTexture="Data/Images/Reticle.png" reticleSize="16,16"
			spriteSheet="Data/Images/Default.png"
			spriteSheetNormal="Data/Images/Default.png"
			spriteSheetEmissive="Data/Images/Default.png"
			cellCount="4,1" spriteSize="256,256" spritePivot="0.5,0.0">
		</HUD>
		<Sounds>
			<Sound sound="Fire" name="Data/Audio/DemonAttack.wav"/>
		</Sounds>
	</WeaponDefinition>
</Definitions>
